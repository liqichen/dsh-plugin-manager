{
  "name": "dsh-plugin-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin manager settings section (MCP / skills / plugin packages), backed by a local python service on 127.0.0.1:17891",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
